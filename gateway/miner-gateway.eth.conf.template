# BlockMachine ETH Miner Gateway Configuration
# Template rendered at container start via envsubst
#
# Routes JSON-RPC HTTP traffic to BACKEND_HTTP_PORT (default 8545) and WebSocket
# upgrade traffic to BACKEND_WS_PORT (default 8546). Selection is driven by the
# client's Upgrade header at the map block below.

map_hash_bucket_size 128;

# Auth: validate Bearer token (supports dual-secret rotation)
map $http_authorization $auth_ok {
    default 0;
    "Bearer ${SECRET_V1}" 1;
    ${SECRET_V2_LINE}
}

# Route by Upgrade header: WebSocket to ws port, everything else to http port.
# Using a variable in proxy_pass forces nginx into runtime DNS resolution, which
# is why the resolver directive below is required. The regex is case-insensitive
# (~*) because RFC 6455 makes the Upgrade header value case-insensitive.
map $http_upgrade $rpc_backend {
    default          "http://${BACKEND_HOST}:${BACKEND_HTTP_PORT}";
    "~*^websocket$"  "http://${BACKEND_HOST}:${BACKEND_WS_PORT}";
}

# For plain HTTP RPC ($http_upgrade is empty) leave the Connection header
# unset so nginx doesn't actively force the upstream to close — sending
# "close" defeats any backend keep-alive and adds TCP churn under load.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

upstream metrics_backend {
    server ${METRICS_HOST}:${METRICS_PORT};
}

server {
    listen 443 ssl;
    server_name _;

    # Docker's embedded DNS — required because $rpc_backend is a variable.
    resolver 127.0.0.11 ipv6=off valid=30s;

    ssl_certificate     ${SSL_CERT_PATH};
    ssl_certificate_key ${SSL_KEY_PATH};

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    location / {
        if ($auth_ok = 0) {
            return 401;
        }

        proxy_pass $rpc_backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket timeouts (1 hour for long-lived eth_subscribe streams)
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }


    # Capacity helper (optional, authenticated). This route is always here. It
    # reaches a helper only if you run one, and answers 502 if you do not, which
    # costs a node nothing: see the README.
    #
    # The helper's address is written into proxy_pass literally, so nginx looks
    # it up once at startup using /etc/hosts — which is where Docker puts the
    # host.docker.internal entry from extra_hosts. Holding it in a variable
    # instead makes nginx ask a DNS resolver at request time, and Docker's DNS
    # does not answer for host.docker.internal, so every capacity test would
    # fail with 502. A stopped helper does not stop nginx starting; the name
    # resolves whether or not anything is listening on the port.
    location = /capacity-test {
        if ($auth_ok = 0) {
            return 401;
        }

        proxy_pass http://${CAPACITY_HELPER_HOST}:${CAPACITY_HELPER_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # Prometheus metrics endpoint (authenticated)
    location = /metrics {
        if ($auth_ok = 0) {
            return 401;
        }

        proxy_pass http://metrics_backend/metrics;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 10s;
        proxy_send_timeout 10s;
    }

    location /health {
        return 200 'OK';
        add_header Content-Type text/plain;
    }
}

server {
    listen 80;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location /health {
        return 200 'OK';
        add_header Content-Type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}
